# ─────────────────────────────────────────────────────────────
# 이 파일을 .env.local 로 복사해서 값을 채운다. (.env* 는 추적 제외)
#
# 주의: VITE_ 접두사가 붙은 값은 전부 번들에 박혀 공개된다.
#       anon key 는 공개돼도 되지만(인가는 Postgres RLS 가 담당),
#       service_role 키는 절대 여기에 넣지 않는다.
# ─────────────────────────────────────────────────────────────

# 데이터 어댑터: mock | supabase
# Phase 0~5 는 mock 으로 진행한다 (Supabase 프로젝트 없이도 앱 전체가 동작)
VITE_DATA_SOURCE=mock

# Supabase (Phase 6 이후 필요)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 디자인 대조용 날짜 고정 (KST). 비워두면 실제 오늘 날짜를 쓴다.
# 프로토타입 기준일과 맞추려면 2026-08-20
VITE_MOCK_TODAY=

# 배포 시 Vercel 이 커밋 SHA 를 주입한다 (쿼리 캐시 buster 로 사용)
VITE_APP_VERSION=dev
